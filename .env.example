# =========================================================
# Sistema Explicador Python IA — Variables de entorno
# Copia este archivo a .env y completa los valores reales.
# =========================================================

# ----- Aplicación -----
APP_NAME=Sistema Explicador Python IA
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

# ----- Seguridad / JWT (mínimo 32 caracteres) -----
SECRET_KEY=cambia-esta-clave-en-produccion-por-favor-32chars
JWT_ALGORITHM=HS256
ADMIN_EMAIL=admin@explicador.com
ADMIN_PASSWORD=admin12345
ADMIN_NOMBRE=Administrador
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----- Base de datos PostgreSQL -----
# Para correr local sin Docker, usa: postgresql+asyncpg://postgres:postgres@localhost:5432/sistema_explicador
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/sistema_explicador
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ----- Gemini -----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60

# ----- DeepSeek -----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TIMEOUT_SECONDS=60

# ----- Orquestador IA -----
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_TEMPERATURE=0.4
AI_MAX_RETRIES_JSON_REPAIR=3
AI_MAX_OUTPUT_TOKENS=4096

# ----- LLM propio (modelo entrenado desde cero) -----
# Pon MODEL_ENABLED=true cuando tengas un checkpoint entrenado (ml/train.py).
MODEL_ENABLED=false
MODEL_CHECKPOINT_PATH=training/checkpoints/exp01_best.pt
MODEL_TOKENIZER_PATH=
MODEL_DEVICE=auto
MODEL_MAX_TOKENS=220
MODEL_TEMPERATURE=0.8
MODEL_TOP_K=40

# ----- CORS -----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FILE=logs/sistema.log

# ----- Frontend (Next.js) -----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
