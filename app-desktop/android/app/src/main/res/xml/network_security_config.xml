<?xml version="1.0" encoding="utf-8"?>
<!--
  Permite tráfico HTTP plano hacia hosts de desarrollo.
  En producción, sirve por HTTPS y elimina este archivo.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
