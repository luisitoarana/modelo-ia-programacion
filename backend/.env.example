# Referencia: el lanzador crea backend/.env con claves aleatorias.
# No copie estas muestras como credenciales reales.
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8765
SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_32_O_MAS_CARACTERES
ADMIN_EMAIL=admin@explicador.com
ADMIN_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_UNICA
ADMIN_NOMBRE=Administrador
DATABASE_URL=sqlite+aiosqlite:///./local.db
# Alternativas: postgresql+asyncpg://usuario:clave@localhost:5432/base
#              mysql+aiomysql://usuario:clave@localhost:3306/base
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MODEL_ENABLED=true
POSTGRES_USER=explicador
POSTGRES_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_UNICA
POSTGRES_DB=sistema_explicador
# INSTALL_LOCAL_MODEL=false omite el motor CPU de la imagen (sin respuestas GGUF).
INSTALL_LOCAL_MODEL=true
